# =============================================================
# CLASP IGNORE RULES
# Files/folders to exclude from Google Apps Script deployment
# =============================================================

# Archive folder (development docs)
archive/**

# Documentation (keep in repo, don't deploy)
**/*.md
**/*.txt
README.md
QUICK_START.md
TESTING_GUIDE.md

# Version control
.git/
.gitignore

# IDE
.vscode/

# Node modules (if any)
node_modules/

# TypeScript sources (deploy only compiled JS)
**/*.ts

# Backup files
**/*.bak
*_OLD.*

