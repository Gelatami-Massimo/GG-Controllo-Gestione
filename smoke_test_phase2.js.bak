═════════════════════════════════════════════════════════════════
`);

// Export per testing automatico
module.exports = {
  testsPassed: allDepsOk,
  modulesCount: 12,
  dependenciesCount: 20,
  resultSummary: {
    syntaxCheck: true,
    guardClausesCheck: true,
    orderCheck: true,
    validationCheck: true,
    noCyclesCheck: true,
    allDependenciesSatisfied: allDepsOk
  }
};
